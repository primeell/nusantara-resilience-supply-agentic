{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "sap-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SAP AI Core through the NSRA local bridge",
      "options": {
        "baseURL": "http://127.0.0.1:8765/v1",
        "apiKey": "{env:NSRA_PROXY_KEY}"
      },
      "models": {
        "sap-gpt54": {
          "name": "SAP AI Core GPT-5.4",
          "limit": {
            "context": 32000,
            "output": 4096
          }
        }
      }
    }
  }
}
