SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_AUTH_URL=
SAP_AI_API_URL=
SAP_RESOURCE_GROUP=default
SAP_GPT_DEPLOYMENT_ID=
SAP_CLAUDE_DEPLOYMENT_ID=
